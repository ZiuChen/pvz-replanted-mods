<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PVZ Replanted</GameDir>
    <InteropRefDir Condition="'$(InteropRefDir)' == ''">$(GameDir)\MelonLoader\Il2CppAssemblies</InteropRefDir>
  </PropertyGroup>
</Project>
